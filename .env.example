# Contoh environment untuk Fairuz.dev (Fase 0)
# Salin menjadi .env.local untuk development lokal. Jangan commit file berisi secret.

# Database Neon PostgreSQL (dibutuhkan mulai Fase 3)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js (dibutuhkan mulai Fase 3)
AUTH_SECRET="ganti-dengan-secret-acak-min-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary untuk media proyek (dibutuhkan mulai Fase 4)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
