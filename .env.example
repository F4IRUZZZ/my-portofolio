# Contoh environment untuk Fairuz.dev
# Salin menjadi .env.local untuk development lokal. Jangan commit file berisi secret.

# Database Neon PostgreSQL (wajib untuk dev/build). Pakai connection string POOLED.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-secret-acak-min-32-karakter"

# Google OAuth (Google Cloud Console → Credentials → OAuth client, tipe Web).
# Redirect URI lokal: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Satu-satunya email yang boleh masuk CMS.
ADMIN_EMAIL="alafairuzatthariqs@gmail.com"

# Cloudinary untuk media proyek (dibutuhkan mulai Fase 4)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
